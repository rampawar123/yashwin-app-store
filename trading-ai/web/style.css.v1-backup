* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

:root {
  --bg: #07111f;
  --panel: #0d1a2b;
  --panel2: #101f32;
  --border: #1c3047;
  --text: #edf5ff;
  --muted: #8294aa;
  --accent: #35b8ff;
  --green: #35d49a;
  --yellow: #ffc857;
  --red: #ff647c;
}

body {
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
}

button,
select {
  font: inherit;
}

.app {
  display: flex;
  min-height: 100vh;
}

.sidebar {
  width: 250px;
  background: #091522;
  border-right: 1px solid var(--border);
  padding: 22px 14px;
  display: flex;
  flex-direction: column;
}

.brand {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 0 9px 25px;
}

.brand-logo {
  width: 40px;
  height: 40px;
  border-radius: 11px;
  display: grid;
  place-items: center;
  background: var(--accent);
  color: #03101c;
  font-weight: 900;
  font-size: 22px;
}

.brand h1 {
  font-size: 14px;
  letter-spacing: 1.3px;
}

.brand span {
  color: var(--muted);
  font-size: 8px;
  letter-spacing: 1.5px;
}

nav {
  display: grid;
  gap: 5px;
}

.nav-item {
  border: 0;
  background: transparent;
  color: var(--muted);
  padding: 12px 13px;
  border-radius: 9px;
  text-align: left;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 12px;
}

.nav-item:hover,
.nav-item.active {
  background: var(--panel2);
  color: var(--text);
}

.nav-item.active {
  box-shadow: inset 3px 0 0 var(--accent);
}

.sidebar-bottom {
  margin-top: auto;
}

.mode-box {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px;
  background: #0d1b2b;
  border: 1px solid var(--border);
  border-radius: 10px;
  margin-bottom: 10px;
}

.dot,
.status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--green);
  display: inline-block;
  box-shadow: 0 0 10px var(--green);
}

.mode-box small {
  display: block;
  color: var(--muted);
  font-size: 9px;
}

.mode-box strong {
  font-size: 11px;
}

.emergency {
  width: 100%;
  border: 1px solid #542536;
  background: #21121b;
  color: var(--red);
  padding: 11px;
  border-radius: 9px;
  cursor: pointer;
}

.main {
  flex: 1;
  min-width: 0;
}

.topbar {
  height: 78px;
  border-bottom: 1px solid var(--border);
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 30px;
}

.topbar h2 {
  font-size: 20px;
}

.topbar p,
.hero p,
.panel-header p {
  color: var(--muted);
  font-size: 12px;
  margin-top: 4px;
}

.top-actions {
  display: flex;
  align-items: center;
  gap: 18px;
}

.market-status {
  font-size: 11px;
  color: var(--muted);
  display: flex;
  gap: 7px;
  align-items: center;
}

.avatar {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--panel2);
  border: 1px solid var(--border);
  font-weight: 700;
}

.content {
  padding: 26px 30px;
  max-width: 1500px;
  margin: auto;
}

.hero {
  padding: 25px;
  border: 1px solid var(--border);
  border-radius: 15px;
  background: linear-gradient(120deg, #0e2034, #0b1726);
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18px;
}

.eyebrow {
  color: var(--accent);
  font-size: 10px;
  letter-spacing: 2px;
}

.hero h3 {
  margin-top: 8px;
  font-size: 25px;
}

.hero-badge {
  border: 1px solid #245274;
  border-radius: 10px;
  padding: 13px 20px;
  text-align: center;
}

.hero-badge span {
  display: block;
  color: var(--muted);
  font-size: 9px;
}

.hero-badge strong {
  color: var(--accent);
}

.cards {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
  margin-bottom: 14px;
}

.card,
.panel {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 13px;
}

.card {
  padding: 18px;
}

.card-top,
.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.card-top span:first-child {
  color: var(--muted);
  font-size: 10px;
  letter-spacing: .8px;
}

.card strong {
  display: block;
  font-size: 23px;
  margin-top: 12px;
}

.card small {
  color: var(--muted);
  font-size: 10px;
}

.positive {
  color: var(--green);
}

.signal {
  font-size: 9px !important;
  border: 1px solid #48576b;
  border-radius: 5px;
  padding: 3px 6px;
}

.neutral {
  color: var(--yellow);
}

.grid {
  display: grid;
  grid-template-columns: 1.55fr 1fr;
  gap: 14px;
  margin-bottom: 14px;
}

.panel {
  padding: 19px;
}

.panel-header h3 {
  font-size: 14px;
}

.panel-header select {
  background: var(--panel2);
  color: var(--text);
  border: 1px solid var(--border);
  padding: 7px 9px;
  border-radius: 6px;
  font-size: 11px;
}

.chart {
  height: 270px;
  margin-top: 20px;
  position: relative;
  overflow: hidden;
  border-radius: 8px;
  background:
    linear-gradient(#ffffff08 1px, transparent 1px),
    linear-gradient(90deg, #ffffff08 1px, transparent 1px);
  background-size: 60px 54px;
}

.chart-line {
  position: absolute;
  width: 120%;
  height: 180px;
  top: 45px;
  left: -8%;
  border-bottom: 3px solid var(--accent);
  transform: rotate(-5deg) skewY(8deg);
  border-radius: 50%;
  box-shadow: 0 0 16px #35b8ff44;
}

.chart-label {
  position: absolute;
  right: 7px;
  color: var(--muted);
  font-size: 9px;
}

.l1 { top: 10px; }
.l2 { top: 75px; }
.l3 { top: 140px; }
.l4 { top: 205px; }

.ai-view {
  padding-top: 24px;
}

.big-signal {
  font-size: 28px;
  font-weight: 800;
  color: var(--yellow);
}

.meter {
  height: 7px;
  background: #172638;
  border-radius: 20px;
  overflow: hidden;
  margin: 16px 0;
}

.meter-fill {
  height: 100%;
  width: 50%;
  background: var(--yellow);
  transition: width .4s;
}

.signal-details {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.signal-details div {
  background: var(--panel2);
  padding: 12px;
  border-radius: 8px;
}

.signal-details span {
  display: block;
  color: var(--muted);
  font-size: 9px;
}

.signal-details strong {
  display: block;
  margin-top: 4px;
  font-size: 12px;
}

.analysis-text {
  color: var(--muted);
  font-size: 11px;
  line-height: 1.6;
  margin-top: 16px;
}

.ai-icon {
  color: var(--accent);
  font-size: 20px;
}

.safe {
  color: var(--green);
  font-size: 9px;
}

.risk-list,
.status-list {
  margin-top: 15px;
}

.risk-list div,
.status-list div {
  display: flex;
  justify-content: space-between;
  padding: 10px 0;
  border-bottom: 1px solid #ffffff08;
  font-size: 11px;
}

.risk-list span,
.status-list span {
  color: var(--muted);
}

.status-list strong {
  font-size: 9px;
}

.status-dot.off {
  background: var(--red);
  box-shadow: 0 0 8px var(--red);
}

footer {
  display: flex;
  justify-content: space-between;
  color: #52657b;
  font-size: 9px;
  padding: 15px 2px;
}

.toast {
  position: fixed;
  right: 22px;
  bottom: 22px;
  background: #142337;
  border: 1px solid var(--border);
  padding: 13px 17px;
  border-radius: 9px;
  color: var(--text);
  font-size: 12px;
  transform: translateY(100px);
  transition: .25s;
}

.toast.show {
  transform: translateY(0);
}

@media (max-width: 900px) {
  .sidebar {
    width: 72px;
  }

  .brand h1,
  .brand span,
  .nav-item span,
  .mode-box div,
  .emergency {
    display: none;
  }

  .brand {
    justify-content: center;
  }

  .nav-item {
    justify-content: center;
  }

  .cards {
    grid-template-columns: repeat(2, 1fr);
  }

  .grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 600px) {
  .topbar {
    padding: 0 15px;
  }

  .content {
    padding: 15px;
  }

  .market-status {
    display: none;
  }

  .hero {
    padding: 18px;
  }

  .hero h3 {
    font-size: 19px;
  }

  .hero-badge {
    display: none;
  }

  .cards {
    grid-template-columns: 1fr 1fr;
  }

  .card {
    padding: 14px;
  }

  .card strong {
    font-size: 18px;
  }
}
