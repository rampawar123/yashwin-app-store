# Resolve application home directory
APP_HOME=$( cd "${0%/*}" && pwd -P ) || exit

# Determine the Java command to use to start the JVM.
if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
        JAVACMD=$JAVA_HOME/jre/sh/java
    else
        JAVACMD=$JAVA_HOME/bin/java
    fi
    if [ ! -x "$JAVACMD" ] ; then
        echo "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME" >&2
        echo "Please set the JAVA_HOME variable in your environment to match the location of your Java installation (JDK 17+ required)." >&2
        exit 1
    fi
else
    JAVACMD=java
    command -v java >/dev/null 2>&1 || {
        echo "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH." >&2
        echo "Please install JDK 17+ and Android SDK (API 34) to build the YASHWIN AI Trading APK." >&2
        exit 1
    }
fi

if command -v gradle >/dev/null 2>&1 ; then
    exec gradle -p "$APP_HOME" "$@"
fi

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar
if [ ! -f "$CLASSPATH" ] ; then
    echo "ERROR: gradle-wrapper.jar not found at $CLASSPATH and no system 'gradle' binary in PATH." >&2
    exit 1
fi

exec "$JAVACMD" -Xmx64m -Xms64m -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
