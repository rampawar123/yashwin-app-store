<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yashwin_bg_primary"
    android:fitsSystemWindows="true">

    <!-- Primary WebView Container -->
    <WebView
        android:id="@+id/tradingWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/yashwin_bg_primary" />

    <!-- Top Indeterminate Progress Bar + Splash Loading Overlay -->
    <LinearLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/yashwin_bg_primary"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="visible">

        <ProgressBar
            android:id="@+id/loadingProgressBar"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/loadingTitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/app_name"
            android:textColor="@color/yashwin_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/loadingPaperBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/paper_mode_badge"
            android:textColor="@color/yashwin_accent_emerald"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/loadingSubtitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/loading_message"
            android:textColor="@color/yashwin_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Recoverable Offline / TLS / Backend Error Screen (Zero Fabricated Market Data) -->
    <LinearLayout
        android:id="@+id/errorOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/yashwin_bg_primary"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/errorBadgeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/paper_mode_badge"
            android:textColor="@color/yashwin_warning_amber"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/errorTitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="@string/offline_title"
            android:textColor="@color/yashwin_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/errorDescriptionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/offline_description"
            android:textColor="@color/yashwin_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/errorDiagnosticText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/localhost_warning_note"
            android:textColor="@color/yashwin_text_secondary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/yashwin_accent_blue"
            android:paddingHorizontal="28dp"
            android:paddingVertical="12dp"
            android:text="@string/retry_connection"
            android:textColor="@color/yashwin_text_primary" />
    </LinearLayout>

</FrameLayout>
